# 端口与监听
PORT=19250
HOST=127.0.0.1

# 数据目录（配置 JSON + SQLite 库文件；相对路径按进程工作目录解析）
QUOTAHUB_DATA_DIR=./data

# 静态前端目录覆盖（留空则用二进制内嵌产物）
# QUOTAHUB_STATIC_DIR=/abs/path/to/web/dist

# 采集脚本沙箱超时（毫秒，100~30000）
QUOTAHUB_SCRIPT_TIMEOUT_MS=2000

# SSRF：=1 时允许请求内网/环回地址（默认仅官方 HTTPS 端点）
# QUOTAHUB_ALLOW_PRIVATE=1

# 认证模式：builtin（自带账号，默认）/ sso（只认 X-Auth-User）
AUTH_MODE=builtin
QUOTAHUB_ADMIN_USER=admin
# 首启创建管理员的口令；留空则随机生成并只打印一次
QUOTAHUB_ADMIN_PASSWORD=
QUOTAHUB_SESSION_TTL_HOURS=12

# 数据库方言：sqlite（默认）/ mysql
DB_DRIVER=sqlite
# SQLite 库路径（默认 <数据目录>/monitor.db）
# DB_PATH=./data/monitor.db
# MySQL（仅 DB_DRIVER=mysql 时读取；也可直接给一条 DB_DSN）
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=quotahub
# DB_USER=quotahub
# DB_PASSWORD=
# DB_DSN=
