# Copy to .env and fill in your values. Never commit your real .env.

# URL of your SSO authentication center (as shown to users, e.g. https://auth.example.com/auth)
# Vite injects this at build time; SSO 401 redirects go to this address.
VITE_AUTH_CENTER_URL=https://auth.example.com/auth

# Development: URL of the backend API the Vite dev server proxies /api to.
# Leave default for the same-machine backend on port 19250.
VITE_API_PROXY_TARGET=http://127.0.0.1:19250